# GitHub OAuth Application Credentials
# Obtain these from: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Application Configuration
APP_NAME="GitHub Profile DevCard & Stats Generator"
BASE_URL=http://localhost:8000
SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production

# Optional: Default theme for generated cards (midnight, cyberpunk, nord, dracula, slate, light)
DEFAULT_THEME=midnight
